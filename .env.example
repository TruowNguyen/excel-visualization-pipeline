# Copy this file to .env; FastAPI loads it without overriding existing process variables.
# Never commit .env or replace these placeholders with real secrets here.

# Excel Visualization Pipeline
EVP_DATABASE=data/local/analytics.sqlite3
EVP_SOURCE_KEY=cx_report_master

# Gemini through 9Router's OpenAI-compatible API — server-side only.
# Create the key in the 9Router dashboard and verify enabled models via GET /v1/models.
# Do not rename these to VITE_*: VITE_* values are exposed to browsers.
GEMINI_API_KEY=your_9router_api_key_here
GEMINI_API_BASE_URL=https://9router.cool.khokey.com/v1
GEMINI_MODEL=ag/gemini-3.7-flash-high

# AI Insights is opt-in. External requests require both flags to be true.
# Keep EVP_AI_EXTERNAL_ALLOWED=false until privacy/provider review is approved.
EVP_AI_ENABLED=false
EVP_AI_EXTERNAL_ALLOWED=false
EVP_AI_TIMEOUT_SECONDS=20
EVP_AI_MAX_RETRIES=1
